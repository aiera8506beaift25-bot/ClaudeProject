# ClauseWise Environment Variables

# API Configuration (for future phases)
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_CLAUDE_API_KEY=your_key_here

# Database Configuration (for future phases)
